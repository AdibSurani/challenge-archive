N = 
c = 
hint1 = 
hint2 = 

h1, h2 = [mod(x,N^2) for x in (hint1,hint2)]
M = matrix(ZZ, [
    [N, 0, 0, 0, 0, 0],
    [0, N, 0, 0, 0, 0],
    [-h2, h2/h1, 1, 0, 0, 0],
    [0, -h1, 0, 1, 0, 0],
    [0, 0, -h2, 0, 1, 0],
    [h1*h2/2, -h2, -h1, h2/h1/2, h1/h2/2, 1],
])
M[:-1] *= N

d = 2^1024 * 13^37
D = diagonal_matrix([1, d, d, d^2, d^2, d^2])
p = gcd(N, (M*D).LLL()[:-1].right_kernel_matrix()[0,1])
print(pow(c, pow(65537, -1, (p-1)*(N//p-1)), N).to_bytes(88))
